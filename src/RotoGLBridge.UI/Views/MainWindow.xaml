<Window x:Class="RotoGLBridge.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:RotoGLBridge.UI"
        xmlns:v="clr-namespace:RotoGLBridge.UI.Views"
        xmlns:vm="clr-namespace:RotoGLBridge.UI.ViewModels"
        xmlns:c="clr-namespace:RotoGLBridge.UI.Convertors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Roto Gamelink Bridge" Height="600" Width="960" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <c:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
    </Window.Resources>
    <Grid Background="#DFDFDF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
            <Image Source="{StaticResource rotoLogo}" Width="240"/>
            <TextBlock Text="GameLink Bridge" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- Right Panel -->
        <Grid Grid.Column="1" Grid.RowSpan="2" Margin="10">
            <helix:HelixViewport3D x:Name="viewPort"
                                   ZoomExtentsWhenLoaded="False"
                                   ShowCameraInfo="False"
                                   IsMoveEnabled="False"
                                   IsPanEnabled="False"
                                   IsRotationEnabled="False"
                                   ShowViewCube="False"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                <helix:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="-56 -104 111" LookDirection="56 102 -73" UpDirection="0 0 1"/>
                </helix:HelixViewport3D.Camera>
                <helix:DefaultLights />
                <ModelVisual3D Content="{Binding RotoChairGroup}" />
                <ModelVisual3D Content="{Binding RotoBaseGroup}" />
            </helix:HelixViewport3D>
            <Button Width="32" Height="32"
                 Command="{Binding OpenSettingsCommand}"
                 ToolTip="Settings"
                 Style="{DynamicResource MaterialDesignIconButton}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0">
                <materialDesign:PackIcon Kind="Cog" Width="22" Height="22"/>
            </Button>
            <!--<TextBlock x:Name="YawTB" HorizontalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" Text="{Binding Yaw,Converter={StaticResource negateConverter}, StringFormat=' {0:F1}°'}" FontSize="36" FontWeight="Bold"  VerticalAlignment="Top"/>-->
        </Grid>

        <StackPanel Grid.Column="0" Grid.Row="1" Margin="10">
            <GroupBox Header="Controls" Padding="10">
                <HeaderedContentControl.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Normal" FontSize="14" Foreground="White"/>
                    </DataTemplate>
                </HeaderedContentControl.HeaderTemplate>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Yaw:" VerticalAlignment="Center" Width="40" />
                        <Slider IsEnabled="{Binding Animated, Converter={StaticResource inverseBooleanConverter}}" Value="{Binding Yaw, Mode=TwoWay}" Minimum="0" Maximum="360" Width="393" Margin="5,0"/>
                        <TextBlock Text="{Binding Yaw, StringFormat='{}{0:F1}°'}" VerticalAlignment="Center" Width="50" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Amp" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Amp, StringFormat='{}{0:F1} %'}" VerticalAlignment="Center" Width="50" Margin="0,0,5,0"/>                         
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Freq" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Hz, StringFormat='{}{0:F1} ms'}" VerticalAlignment="Center" Width="70" Margin="0,0,5,0"/>

                        <TextBlock Text="Hz" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Hertz, StringFormat='{}{0:F0} per/s'}" VerticalAlignment="Center" Width="70" Margin="0,0,5,0"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <ContentControl Content="{Binding Rumbleview}" Height="200" />
                    </StackPanel>
                    <!--<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Spin" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ToggleButton IsChecked="{Binding Animated}" 
                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                  VerticalAlignment="Center"
                  ToolTip="Toggle animation"/>
                        </StackPanel>
                        --><!--<Button Content="Spin" Command="{Binding StartYawAnimationCommand}" Margin="0,0,5,0" Foreground="White" IsEnabled="{Binding Animated, Converter={StaticResource inverseBooleanConverter}}"/>
                        <Button Content="Stop" Command="{Binding StopYawAnimationCommand}" Margin="0,0,5,0" Foreground="White" IsEnabled="{Binding Animated}"/>--><!--
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Start" Foreground="White" Command="{Binding StartEngineCommand}" Margin="0,0,5,0" IsEnabled="{Binding IsEngineRunning, Converter={StaticResource inverseBooleanConverter}}"/>
                        <Button Content="Stop" Foreground="White" Command="{Binding StopEngineCommand}" Margin="0,0,5,0" IsEnabled="{Binding IsEngineRunning}" />
                        </StackPanel>-->
                    <StackPanel Orientation="Vertical" >
                        <!--<v:ConnectionStatusControl Status="{Binding GamelinkConnected}" Label="Receiving Telemetry"  Margin="0,10,10,5"/>
                        <v:ConnectionStatusControl Status="{Binding RotoConnected}" Label="Chair Connected"  Margin="0,10,10,5"/>
                        <v:ConnectionStatusControl Status="{Binding TcpConnected}" Label="Gamelink Connected"  Margin="0,10,10,5"/>-->

                        <ContentControl Content="{Binding GamelinkConnected}" Margin="0,10,10,5"/>
                        <ContentControl Content="{Binding RotoConnected}" Margin="0,10,10,5"/>
                        <ContentControl Content="{Binding TcpConnected}" Margin="0,10,10,5"/>
                        <ContentControl Content="{Binding OxrmcConnected}" Margin="0,10,10,5"/>
                        
                        <!-- <v:ConnectionStatusControl Status="{Binding OxrmcConnected}" Label="OXRMC"  Margin="0,10,10,5" />
                       <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Roto:" FontWeight="Bold" Margin="0,10,10,5" />
                            <TextBlock Text="{Binding RotoConnected}" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <v:ConnectionStatusControl Status="{Binding OxrmcConnected}" Label="OXRMC"  Margin="0,10,10,5"/>                           
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gamlink:" FontWeight="Bold" Margin="0,10,10,5" />
                            <TextBlock Text="{Binding GamelinkConnected}" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TCP:" FontWeight="Bold" Margin="0,10,10,5" />
                            <TextBlock Text="{Binding TcpConnected}" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>-->
                    </StackPanel>
                    
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Yaw, StringFormat='Yaw: {0:F1}°'}"/>
            </StatusBarItem>
            <Separator/>
           
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgramVersion, StringFormat='Version: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Developed by Drowhunter" FontSize="12" FontStyle="Italic"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
