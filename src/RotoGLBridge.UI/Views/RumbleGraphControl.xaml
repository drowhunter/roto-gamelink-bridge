<UserControl x:Class="RotoGLBridge.UI.Views.RumbleGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RotoGLBridge.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400" Loaded="UserControl_Loaded">
    <StackPanel Orientation="Vertical">
        <ScottPlot:WpfPlot x:Name="RumblePlot" Margin="5,5,5,5" Loaded="RumblePlot_Loaded" Unloaded="RumblePlot_Unloaded" Width="400" Height="260" />
    </StackPanel>
</UserControl>
