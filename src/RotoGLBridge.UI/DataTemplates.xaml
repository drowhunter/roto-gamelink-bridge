<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:vm="clr-namespace:RotoGLBridge.UI.ViewModels" 
                    xmlns:v="clr-namespace:RotoGLBridge.UI.Views">
    <DataTemplate DataType="{x:Type vm:ConnectionStatusViewModel}" >
        <v:ConnectionStatusControl />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RumbleGraphViewModel}">
        <v:RumbleGraphControl />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ErrorModeViewModel}">
        <v:ErrorModeUserControl />
    </DataTemplate>
</ResourceDictionary>