<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>

  <!-- Keep the files as content (None), but custom copy logic will handle placing them in TargetDir -->
  <ItemGroup>
    <None Include="Libs\x64\HIDApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Libs\x86\HIDApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Copy architecture-specific HIDApi.dll into $(TargetDir) -->
  <Target Name="CopyHIDApi" AfterTargets="Build">
    <!-- Normalize PlatformTarget (AnyCPU at build time can't decide, so skip unless explicitly x64/x86) -->
    <PropertyGroup>
      <_ResolvedPlatform Condition="'$(PlatformTarget)' == ''">$(Platform)</_ResolvedPlatform>
      <_ResolvedPlatform Condition="'$(_ResolvedPlatform)' == ''">AnyCPU</_ResolvedPlatform>
    </PropertyGroup>

    <ItemGroup>
      <_HidSource Include="$(ProjectDir)\Libs\$(_ResolvedPlatform)\HIDApi.dll" Condition=" '$(_ResolvedPlatform)' != 'AnyCPU' AND Exists('$(ProjectDir)Libs\$(_ResolvedPlatform)\HIDApi.dll') " />
    </ItemGroup>

    <Message Text="Copying HIDApi.dll for platform $(_ResolvedPlatform)" Importance="High" Condition="'@(_HidSource)' != ''" />
    <Copy SourceFiles="@(_HidSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(_HidSource)' != ''" />
    <Warning Text="No platform-specific $(_HidSource) copied (PlatformTarget=$(PlatformTarget))." Condition="'@(_HidSource)' == ''" />
  </Target>

</Project>
